{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Setup: Install Dependencies",
			"type": "shell",
			"command": "npm install",
			"icon": {
				"id": "cloud-download",
				"color": "charts.blue"
			}
		},
		{
			"label": "Setup: Rename Element",
			"detail": "Change the tag name and class name of the custom element. Class name is optional.",
			"type": "shell",
			"command": "npm run rename -- --tag ${input:tagName} --class ${input:className}"
		},
		{
			"label": "Test: Check Types",
			"detail": "Check for type correctness.",
			"type": "npm",
			"script": "typecheck",
			"group": "build",
			"presentation": {
				"clear": true,
				"reveal": "silent",
				"showReuseMessage": false
			},
			"icon": {
				"id": "beaker",
				"color": "terminal.ansiGreen"
			}
		},
		{
			"label": "Dev: Host on Dev",
			"detail": "Host the unbundled source for hot module reload.",
			"type": "npm",
			"script": "dev",
			"presentation": {
				"clear": true,
				"reveal": "silent",
				"showReuseMessage": false
			},
			"icon": {
				"id": "globe",
				"color": "terminal.ansiGreen"
			}
		},
		{
			"label": "Prod: Build",
			"detail": "Build the output JS file into './dist/'.",
			"type": "npm",
			"script": "build",
			"group": "build",
			"presentation": {
				"clear": true,
				"reveal": "silent",
				"showReuseMessage": false
			}
		},
		{
			"label": "Prod: Preview on Prod",
			"detail": "Host the bundled output in 'dist/'.",
			"type": "npm",
			"script": "preview",
			"presentation": {
				"clear": true,
				"reveal": "silent",
				"showReuseMessage": false
			},
			"icon": {
				"id": "globe",
				"color": "terminal.ansiRed"
			}
		}
	],
	"inputs": [
		{
			"id": "tagName",
			"type": "promptString",
			"description": "Tag name (e.g., 'my-element'), required",
			"default": "",
			"password": false
		},
		{
			"id": "className",
			"type": "promptString",
			"description": "Class name (e.g., 'MyElement'), optional",
			"default": "",
			"password": false
		}
	]
}
